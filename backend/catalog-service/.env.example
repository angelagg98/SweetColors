# Copia este archivo como .env (mismo directorio) y rellena tus valores.
# El .env NO se sube a Git (.gitignore ya lo excluye). Las credenciales del
# servidor MySQL compartido del equipo pidelas a tu companero o revisa el .env
# del auth-service como referencia.
DB_HOST=TU_IP_TAILSCALE_O_SERVIDOR
DB_PORT=3306
DB_USERNAME=TU_USUARIO
DB_PASSWORD=TU_PASSWORD