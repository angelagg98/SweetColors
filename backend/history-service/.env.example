# Copia este archivo como .env (mismo directorio) y rellena tus valores.
# El .env NO se sube a Git (.gitignore ya lo excluye).
DB_HOST=TU_IP_TAILSCALE_O_SERVIDOR
DB_PORT=3306
DB_USERNAME=TU_USUARIO
DB_PASSWORD=TU_PASSWORD
# URL base del wishlist-service (donde se consultan los eventos)
WISHLIST_BASE_URL=http://localhost:8083